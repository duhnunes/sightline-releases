{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": ".rdx/.next",
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/duhnunes/sightline-releases/releases/latest/download/Sightline.zip",
      "permanent": false
    }
  ]
}
